# Origin for canonical links, sitemap, RSS and OG images. No trailing slash and
# no repository path. GitHub examples:
#   project site: https://yourname.github.io
#   custom domain: https://dipo.dev
SITE_URL=https://dipo.dev

# Repository path. Use /repo-name for username.github.io/repo-name, otherwise /.
BASE_PATH=/

# Sanity (build-time). Leave PUBLIC_SANITY_PROJECT_ID empty to build from the
# local CV fallback in src/content/seed.ts.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Only needed for a private dataset. Never expose this to the browser.
SANITY_API_TOKEN=

# Local previews only. A draft-enabled Sanity token; never set this in CI.
SANITY_PREVIEW_TOKEN=

# Cloudflare Worker API origin (no trailing slash). Leave empty for local
# preview; the contact form falls back to mailto and comments/reacts go quiet.
PUBLIC_API_URL=

# Cloudflare Turnstile site key (public).
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics beacon token (public, cookie-free). Optional.
PUBLIC_CF_ANALYTICS_TOKEN=
