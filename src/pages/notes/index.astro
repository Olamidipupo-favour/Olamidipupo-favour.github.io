---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NotesIndex from "@/components/NotesIndex.astro";
import { getContent } from "@/lib/content";
import { withBase } from "@/lib/utils";

const content = await getContent();
const posts = [...content.posts].sort(
  (a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime(),
);
---

<BaseLayout
  content={content}
  title="Notes"
  description="Backend notes, med-school notes and arguments about fundamentals from Dipo Agboola."
  ogSlug="notes"
>
  <div class="shell py-14 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="chapter-kicker">Chapter 03 · Notes</p>
        <h1 class="chapter-title mt-2 text-4xl sm:text-6xl">Notes from the terminal.</h1>
        <p class="mt-4 max-w-2xl text-base leading-7 text-muted">
          Longer thoughts on backends, systems, medicine and the fundamentals
          that keep showing up. Sorted however you like.
        </p>
      </div>
      <a class="btn btn-sm" href={withBase("/rss.xml")}>RSS feed</a>
    </div>

    <div class="mt-10">
      <NotesIndex posts={posts} />
    </div>
  </div>
</BaseLayout>
