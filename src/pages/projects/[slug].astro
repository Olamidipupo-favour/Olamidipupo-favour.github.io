---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getContent } from "@/lib/content";
import type { Content, Project } from "@/lib/types";
import { absoluteUrl, isPlaceholder, withBase } from "@/lib/utils";
import { ArrowLeft, ArrowRight, ArrowUpRight, Check } from "lucide-astro";

export async function getStaticPaths() {
  const content = await getContent();
  const projects = [...content.projects].sort((a, b) => a.order - b.order);
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      content,
      next: projects[(index + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  content: Content;
  next: Project;
}
const { project, content, next } = Astro.props;
const { settings } = content;
const hasPlaceholder = [project.problem, project.approach, project.outcome, project.bodyHtml]
  .some((value) => isPlaceholder(value));
const sections = [
  { number: "01", title: "The problem", value: project.problem },
  { number: "02", title: "My role", value: project.role },
  { number: "03", title: "The approach", value: project.approach },
  { number: "04", title: "The outcome", value: project.outcome },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.title,
  description: project.summary,
  author: { "@type": "Person", name: settings.name },
  keywords: project.stack.join(", "),
  url: absoluteUrl(`/projects/${project.slug}/`),
};
---

<BaseLayout
  content={content}
  title={`${project.title} — Case Study`}
  description={project.summary}
  ogSlug={`project-${project.slug}`}
  type="article"
  jsonLd={jsonLd}
>
  <article>
    <header class="border-b border-line">
      <div class="shell py-10 sm:py-14">
        <a
          class="inline-flex items-center gap-2 font-mono text-[0.64rem] uppercase tracking-[0.14em] text-muted hover:text-accent"
          href={withBase("/projects")}
        >
          <ArrowLeft class="h-3.5 w-3.5" aria-hidden="true" /> All work
        </a>

        <div class="mt-7 grid gap-8 lg:grid-cols-[1fr_18rem] lg:gap-14">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="tag tag-accent">{project.role}</span>
              {project.metrics[0] && (
                <span class="tag">{project.metrics[0].value} {project.metrics[0].label}</span>
              )}
            </div>
            <h1 class="mt-4 font-display text-[clamp(3rem,9vw,6.5rem)] font-black italic leading-[0.9] tracking-[-0.05em]">
              {project.title}
            </h1>
            <p class="mt-5 max-w-2xl text-base leading-7 text-muted sm:text-lg">
              {project.summary}
            </p>
          </div>

          <aside class="border-t-2 border-ink pt-4 lg:border-l-2 lg:border-t-0 lg:pl-6 lg:pt-0">
            <dl class="space-y-5">
              <div>
                <dt class="font-mono text-[0.58rem] uppercase tracking-[0.16em] text-muted">Stack</dt>
                <dd class="mt-2 flex flex-wrap gap-1.5">
                  {project.stack.map((tech) => <span class="tag">{tech}</span>)}
                </dd>
              </div>
              {project.metrics.length > 0 && (
                <div>
                  <dt class="font-mono text-[0.58rem] uppercase tracking-[0.16em] text-muted">Metrics</dt>
                  <dd class="mt-2 space-y-2">
                    {project.metrics.map((metric) => (
                      <div class="flex items-baseline justify-between gap-3 border-b border-line pb-1.5">
                        <span class="text-xs text-muted">{metric.label}</span>
                        <span class="font-display text-lg font-black italic">{metric.value}</span>
                      </div>
                    ))}
                  </dd>
                </div>
              )}
              {project.links.length > 0 && (
                <div>
                  <dt class="font-mono text-[0.58rem] uppercase tracking-[0.16em] text-muted">Links</dt>
                  <dd class="mt-2 space-y-1.5">
                    {project.links.map((link) => (
                      <a
                        class="flex items-center gap-1.5 font-mono text-xs text-accent hover:underline"
                        href={withBase(link.url)}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {link.label} <ArrowUpRight class="h-3 w-3" aria-hidden="true" />
                      </a>
                    ))}
                  </dd>
                </div>
              )}
            </dl>
          </aside>
        </div>
      </div>
    </header>

    {project.cover?.url && (
      <div class="shell mt-8">
        <img
          src={project.cover.url}
          alt={project.cover.alt || `${project.title} cover image`}
          width={project.cover.width ?? 1600}
          height={project.cover.height ?? 900}
          class="max-h-[34rem] w-full border-2 border-ink object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    )}

    <div class="shell grid gap-10 py-12 lg:grid-cols-[1fr_18rem] lg:gap-14 lg:py-16">
      <div>
        {hasPlaceholder && (
          <p class="mb-8 border-l-4 border-accent bg-surface p-4 font-mono text-[0.7rem] leading-5 text-muted">
            Some details below are clearly marked placeholders. They are waiting
            for the full write-up, not hidden behind confident copy.
          </p>
        )}

        <div class="space-y-10">
          {
            sections.map((section) => (
              <section>
                <div class="flex items-baseline gap-3 border-b border-line pb-2">
                  <span class="font-mono text-[0.6rem] text-accent">{section.number}</span>
                  <h2 class="font-display text-2xl font-black italic tracking-tight sm:text-3xl">
                    {section.title}
                  </h2>
                </div>
                <p class="mt-4 max-w-prose whitespace-pre-line text-[1.02rem] leading-7 text-ink/90">
                  {section.value}
                </p>
              </section>
            ))
          }
        </div>

        {
          project.bodyHtml && (
            <section class="mt-12 border-t-2 border-ink pt-8">
              <h2 class="font-display text-2xl font-black italic tracking-tight sm:text-3xl">
                Field notes
              </h2>
              <div class="prose-manga mt-5" set:html={project.bodyHtml} />
            </section>
          )
        }

        {
          project.outcome && (
            <div class="mt-12 border-2 border-accent bg-accent/5 p-6">
              <p class="chapter-kicker">Outcome</p>
              <p class="mt-2 flex gap-2 text-sm leading-6">
                <Check class="mt-0.5 h-4 w-4 shrink-0 text-accent" aria-hidden="true" />
                {project.outcome}
              </p>
            </div>
          )
        }
      </div>

      <aside class="space-y-6">
        <div class="border-2 border-line p-5">
          <p class="font-mono text-[0.58rem] uppercase tracking-[0.16em] text-muted">Working together</p>
          <p class="mt-2 text-sm leading-6">
            Need this kind of backend work done properly? I am open to remote
            roles and select freelance projects.
          </p>
          <a class="btn btn-primary btn-sm mt-4" href={withBase("/contact")}>Get in touch</a>
        </div>
        <div class="halftone-accent border border-line p-5">
          <p class="font-mono text-[0.58rem] uppercase tracking-[0.16em] text-muted">Next case</p>
          <a
            class="mt-2 inline-flex items-center gap-2 font-display text-xl font-black italic hover:text-accent"
            href={withBase(`/projects/${next.slug}`)}
          >
            {next.title}
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
