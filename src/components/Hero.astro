---
import { ArrowDown, ArrowUpRight, MapPin } from "lucide-astro";
import Avatar from "@/components/Avatar.astro";
import type { SiteSettings } from "@/lib/types";
import { isPlaceholder, statusLabels, withBase } from "@/lib/utils";

interface Props {
  settings: SiteSettings;
}
const { settings } = Astro.props;
const isAvailable = settings.availability.status !== "closed";
const year = new Date().getFullYear();
---

<section id="hero" class="border-b border-line">
  <div class="shell grid gap-14 py-16 sm:py-20 lg:grid-cols-[1.2fr_0.8fr] lg:items-start lg:gap-16 lg:py-24">
    <div>
      <p class="chapter-kicker">Portfolio · {year}</p>

      <h1 class="mt-6 font-display text-[clamp(2.9rem,7.2vw,5.8rem)] font-normal leading-[0.98] tracking-[-0.03em]">
        <span class="sr-only">{settings.name}, backend engineer. </span>
        No cursed energy.<br />
        <span class="text-accent">Just fundamentals.</span>
      </h1>

      <p class="mt-7 max-w-xl text-base leading-8 text-muted sm:text-lg">
        {settings.subline}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
        <span
          class:list={[
            "inline-flex items-center gap-2 font-mono text-[0.64rem] uppercase tracking-[0.14em]",
            isAvailable ? "text-accent" : "text-muted",
          ]}
        >
          <span
            class:list={[
              "h-1.5 w-1.5 rounded-full",
              isAvailable ? "animate-flicker bg-accent" : "bg-muted",
            ]}
            aria-hidden="true"></span>
          {statusLabels[settings.availability.status]}
        </span>
        <span class="inline-flex items-center gap-1.5 font-mono text-[0.64rem] uppercase tracking-[0.1em] text-muted">
          <MapPin class="h-3.5 w-3.5" aria-hidden="true" />
          {settings.location} · remote-first
        </span>
      </div>
      <p class="mt-3 max-w-xl font-mono text-[0.66rem] leading-5 text-muted/90">
        {settings.availability.text}
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={withBase("/projects")}>
          See the work <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
        </a>
        <a class="btn btn-ghost" href={withBase("/work-with-me")}>Work with me</a>
      </div>

      <button
        type="button"
        class="mt-9 flex w-full max-w-md items-center gap-2 border-y border-line px-1 py-3 text-left font-mono text-[0.68rem] text-muted transition-colors hover:border-accent hover:text-ink"
        data-open-terminal
        aria-label="Open interactive terminal"
      >
        <span class="text-accent">dipo@portfolio</span><span>:</span><span>~</span><span>$</span>
        <span class="text-ink">whoami</span>
        <span class="ml-auto inline-block h-3.5 w-1.5 animate-blink bg-accent" aria-hidden="true"></span>
      </button>

      <ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2" aria-label="Social links">
        {
          settings.socials.map((social) => (
            <li>
              <a
                class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-muted underline decoration-line underline-offset-4 hover:text-accent hover:decoration-accent"
                href={social.url}
                target="_blank"
                rel="me noopener noreferrer"
              >
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="lg:border-l lg:border-line lg:pl-10">
      <Avatar settings={settings} size="lg" eager />

      <div class="mt-6">
        <p class="font-display text-2xl">{settings.name}</p>
        <p class="mt-1 font-mono text-[0.62rem] uppercase tracking-[0.16em] text-muted">
          Backend engineer · {settings.location}
        </p>
      </div>

      <dl class="mt-8 space-y-5 border-t border-line pt-6">
        {
          !isPlaceholder(settings.nowBuilding) && (
            <div>
              <dt class="font-mono text-[0.58rem] uppercase tracking-[0.18em] text-muted">
                Now building
              </dt>
              <dd class="mt-1.5 font-display text-lg leading-7 text-ink/90">
                {settings.nowBuilding}
              </dd>
            </div>
          )
        }
        <div>
          <dt class="font-mono text-[0.58rem] uppercase tracking-[0.18em] text-muted">
            Availability
          </dt>
          <dd class="mt-1.5 font-display text-lg leading-7 text-ink/90">
            {statusLabels[settings.availability.status]}
          </dd>
        </div>
      </dl>
    </aside>
  </div>

  <div class="shell flex items-center justify-between border-t border-line py-3 font-mono text-[0.58rem] uppercase tracking-[0.2em] text-muted">
    <span>Selected work below</span>
    <ArrowDown class="h-4 w-4 animate-float" aria-hidden="true" />
  </div>
</section>
