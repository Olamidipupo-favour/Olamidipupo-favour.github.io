---
import { Gamepad2, X } from "lucide-astro";
---

<dialog class="game-dialog" data-game aria-labelledby="game-title">
  <div class="w-full max-w-3xl border border-line bg-bg shadow-panel">
    <div class="flex items-center gap-3 border-b border-line px-4 py-3">
      <Gamepad2 class="h-4 w-4 text-accent" aria-hidden="true" />
      <h2 id="game-title" class="font-mono text-xs uppercase tracking-[0.16em]">
        Keep the Uptime
      </h2>
      <span
        class="ml-auto font-mono text-[0.62rem] uppercase tracking-wider text-muted"
        >scores stay on this device</span
      >
      <button
        type="button"
        class="inline-flex h-8 w-8 items-center justify-center text-muted hover:text-accent"
        data-close-game
        aria-label="Close game"
      >
        <X class="h-4 w-4" aria-hidden="true" />
      </button>
    </div>

    <div class="p-4">
      <div class="mb-3 flex flex-wrap items-center gap-4 font-mono text-[0.68rem]">
        <p>score <span class="text-accent" data-game-score>0</span></p>
        <p>uptime <span class="text-ink" data-game-lives>100%</span></p>
        <p class="text-muted">best <span data-game-best>0</span></p>
        <p class="ml-auto hidden sm:block text-muted">
          ← → move · catch 200s · dodge 500s
        </p>
      </div>

      <div class="relative">
        <canvas
          width="720"
          height="420"
          class="block w-full border border-line bg-[#070a08]"
          data-game-canvas
          role="application"
          tabindex="0"
          aria-label="Keep the Uptime: move a server with the arrow keys. Catch green 200 requests and avoid red 500 errors."
        ></canvas>
        <div
          class="absolute inset-0 flex flex-col items-center justify-center gap-4 bg-[#070a08]/88 p-6 text-center"
          data-game-overlay
        >
          <p class="font-display text-3xl font-medium text-[#EBE7DF]">
            Keep the Uptime
          </p>
          <p class="max-w-sm font-mono text-[0.7rem] leading-5 text-[#9AA8A0]">
            Requests are incoming. Catch the green 200s. Dodge the red 500s.
            Three drops and the pager goes off.
          </p>
          <button type="button" class="btn btn-primary" data-start-game>
            Start shifting
          </button>
          <p class="font-mono text-[0.6rem] text-[#9AA8A0]" data-game-message>
            Keyboard: arrow keys or A/D. Escape pauses.
          </p>
        </div>
      </div>

      <p class="mt-3 font-mono text-[0.6rem] leading-5 text-muted">
        A tiny game, not a benchmark. No account, no upload, no tracking. Your
        best score is saved in localStorage.
      </p>
    </div>
  </div>
</dialog>

<style>
  .game-dialog {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1rem;
    border: 0;
    background: rgb(0 0 0 / 0.72);
    color: rgb(var(--ink));
  }

  .game-dialog[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .game-dialog::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
</style>

<script>
  import { blip } from "@/lib/sound";

  type Drop = { x: number; y: number; type: "ok" | "error"; speed: number };

  const initGame = () => {
    const dialog = document.querySelector<HTMLDialogElement>("[data-game]");
    if (!dialog || dialog.dataset.ready === "true") return;
    dialog.dataset.ready = "true";

    const canvas = dialog.querySelector<HTMLCanvasElement>("[data-game-canvas]");
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return;

    const overlay = dialog.querySelector<HTMLElement>("[data-game-overlay]");
    const scoreNode = dialog.querySelector<HTMLElement>("[data-game-score]");
    const livesNode = dialog.querySelector<HTMLElement>("[data-game-lives]");
    const bestNode = dialog.querySelector<HTMLElement>("[data-game-best]");
    const message = dialog.querySelector<HTMLElement>("[data-game-message]");
    const startButton = dialog.querySelector<HTMLButtonElement>("[data-start-game]");

    const W = canvas.width;
    const H = canvas.height;
    const keys = new Set<string>();
    const player = { x: W / 2 - 46, y: H - 38, w: 92, h: 18 };
    let drops: Drop[] = [];
    let score = 0;
    let lives = 3;
    let running = false;
    let last = 0;
    let spawnAt = 0;
    let raf = 0;
    let best = 0;

    try {
      best = Number(localStorage.getItem("dipo-uptime-best") ?? 0) || 0;
    } catch {
      best = 0;
    }
    if (bestNode) bestNode.textContent = String(best);

    const setHud = () => {
      if (scoreNode) scoreNode.textContent = String(score);
      if (livesNode)
        livesNode.textContent = `${Math.max(0, Math.round((lives / 3) * 100))}%`;
    };

    const reset = () => {
      drops = [];
      score = 0;
      lives = 3;
      player.x = W / 2 - player.w / 2;
      setHud();
    };

    const start = () => {
      reset();
      running = true;
      last = performance.now();
      spawnAt = 0;
      if (overlay) overlay.style.display = "none";
      if (message) message.textContent = "";
      canvas.focus();
      blip(700, 0.08);
      window.cancelAnimationFrame(raf);
      raf = requestAnimationFrame(loop);
    };

    const end = () => {
      running = false;
      window.cancelAnimationFrame(raf);
      if (score > best) {
        best = score;
        try {
          localStorage.setItem("dipo-uptime-best", String(best));
        } catch {
          // High score is best-effort; never break the game.
        }
        if (bestNode) bestNode.textContent = String(best);
        if (message) message.textContent = "New personal best. The pager stays quiet.";
      } else if (message) {
        message.textContent = "The pager went off. Ship it and try again.";
      }
      if (overlay) overlay.style.display = "flex";
      if (startButton) {
        startButton.innerHTML = "";
        startButton.textContent = "Run it back";
      }
      if (score > 0) blip(240, 0.16);
    };

    const draw = () => {
      ctx.fillStyle = "#070A08";
      ctx.fillRect(0, 0, W, H);

      ctx.strokeStyle = "rgba(34,197,94,0.08)";
      ctx.lineWidth = 1;
      for (let x = 0; x < W; x += 40) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, H);
        ctx.stroke();
      }
      for (let y = 0; y < H; y += 40) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(W, y);
        ctx.stroke();
      }

      ctx.fillStyle = "#0F1712";
      ctx.fillRect(0, H - 14, W, 14);

      ctx.fillStyle = "#EBE7DF";
      ctx.font = "700 13px monospace";
      ctx.fillText("dipo@portfolio:~$ uptime --watch", 14, 20);

      for (const drop of drops) {
        ctx.fillStyle = drop.type === "ok" ? "#C8A25F" : "#F87171";
        ctx.fillRect(drop.x - 22, drop.y - 12, 44, 24);
        ctx.fillStyle = "#06100A";
        ctx.font = "700 11px monospace";
        ctx.textAlign = "center";
        ctx.fillText(drop.type === "ok" ? "200" : "500", drop.x, drop.y + 4);
        ctx.textAlign = "left";
      }

      ctx.fillStyle = "#C8A25F";
      ctx.fillRect(player.x, player.y, player.w, player.h);
      ctx.fillStyle = "#070A08";
      ctx.fillRect(player.x + 4, player.y + 4, player.w - 8, 4);
      ctx.fillStyle = "#EBE7DF";
      ctx.fillRect(player.x + player.w / 2 - 2, player.y + 5, 4, 4);
      ctx.fillStyle = "#24402E";
      ctx.fillRect(player.x + 10, player.y + player.h, 6, 6);
      ctx.fillRect(player.x + player.w - 16, player.y + player.h, 6, 6);
    };

    const loop = (now: number) => {
      if (!running) return;
      const delta = Math.min(32, now - last) / 16.67;
      last = now;
      spawnAt += delta;

      if (keys.has("ArrowLeft") || keys.has("a")) player.x -= 7 * delta;
      if (keys.has("ArrowRight") || keys.has("d")) player.x += 7 * delta;
      player.x = Math.max(4, Math.min(W - player.w - 4, player.x));

      const interval = Math.max(18, 48 - score * 0.35);
      if (spawnAt > interval) {
        spawnAt = 0;
        const bad = Math.random() < Math.min(0.34, 0.14 + score / 700);
        drops.push({
          x: 30 + Math.random() * (W - 60),
          y: -20,
          type: bad ? "error" : "ok",
          speed: 2.1 + Math.random() * 1.4 + Math.min(2, score / 80),
        });
      }

      drops.forEach((drop) => {
        drop.y += drop.speed * delta;
      });

      drops = drops.filter((drop) => {
        const caught =
          drop.y + 12 >= player.y &&
          drop.y - 12 <= player.y + player.h &&
          drop.x >= player.x - 22 &&
          drop.x <= player.x + player.w + 22;

        if (caught) {
          if (drop.type === "ok") {
            score += 10;
            blip(640, 0.035, 0.02);
          } else {
            lives -= 1;
            if (lives <= 0) end();
            blip(180, 0.12, 0.04);
          }
          setHud();
          return false;
        }

        if (drop.y > H + 20) {
          if (drop.type === "ok") {
            lives -= 1;
            setHud();
            if (lives <= 0) end();
            blip(220, 0.06, 0.03);
          }
          return false;
        }
        return true;
      });

      draw();
      if (running) raf = requestAnimationFrame(loop);
    };

    startButton?.addEventListener("click", start);
    dialog.querySelectorAll("[data-close-game]").forEach((button) => {
      button.addEventListener("click", () => dialog.close());
    });
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => {
      running = false;
      window.cancelAnimationFrame(raf);
    });
    dialog.addEventListener("cancel", () => {
      running = false;
      window.cancelAnimationFrame(raf);
    });

    window.addEventListener("keydown", (event) => {
      if (!dialog.open) return;
      if (["ArrowLeft", "ArrowRight", "a", "d", "A", "D"].includes(event.key)) {
        event.preventDefault();
        keys.add(event.key);
      }
      if (event.key === "Escape") {
        running = false;
        window.cancelAnimationFrame(raf);
      }
    });
    window.addEventListener("keyup", (event) => {
      keys.delete(event.key);
    });

    // Pointer control, mapped to the fixed canvas coordinate space.
    canvas.addEventListener("pointermove", (event) => {
      if (!running) return;
      const rect = canvas.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width) * W;
      player.x = Math.max(4, Math.min(W - player.w - 4, x - player.w / 2));
    });

    draw();

    const open = () => {
      if (!dialog.open) dialog.showModal();
      reset();
      if (overlay) overlay.style.display = "flex";
      if (startButton) startButton.textContent = "Start shifting";
      if (message) message.textContent = "Keyboard: arrow keys or A/D. Escape pauses.";
      draw();
    };

    document.querySelectorAll("[data-open-game]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        open();
      });
    });
  };

  initGame();
  document.addEventListener("astro:page-load", initGame);
</script>
