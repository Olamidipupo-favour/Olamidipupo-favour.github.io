---
import type { Experience } from "@/lib/types";

interface Props {
  experience: Experience[];
}
const { experience } = Astro.props;
const rows = [...experience].sort((a, b) => a.order - b.order);
---

<ol class="relative space-y-8 border-l-2 border-line pl-6 sm:pl-8">
  {
    rows.map((job) => (
      <li class="relative">
        <span
          class="absolute -left-[calc(1.5rem+7px)] top-1.5 h-3 w-3 rounded-full border-2 border-bg bg-accent sm:-left-[calc(2rem+7px)]"
          aria-hidden="true"
        />
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="font-display text-xl font-black italic tracking-tight sm:text-2xl">
            {job.role}
          </h3>
          <p class="font-mono text-[0.64rem] uppercase tracking-[0.12em] text-muted">
            {job.startDate} – {job.endDate}
          </p>
        </div>
        <p class="mt-1 font-mono text-xs uppercase tracking-[0.1em] text-accent">
          {job.company}{job.location ? ` · ${job.location}` : ""}
        </p>
        <ul class="mt-3 space-y-1.5 text-sm leading-6 text-muted">
          {job.bullets.map((bullet) => (
            <li class="flex gap-2">
              <span class="mt-2 h-1 w-3 shrink-0 bg-accent" aria-hidden="true" />
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>
