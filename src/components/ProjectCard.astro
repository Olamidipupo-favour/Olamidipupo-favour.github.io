---
import type { Project } from "@/lib/types";
import { withBase } from "@/lib/utils";

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const number = String(index + 1).padStart(2, "0");
const cover = project.cover?.url ? project.cover : null;
---

<a
  href={withBase(`/projects/${project.slug}`)}
  class:list={[
    "group block border-t border-line py-10 transition-colors hover:border-accent/60 sm:py-12",
    cover && "sm:grid sm:grid-cols-[1fr_15rem] sm:gap-10",
  ]}
>
  <div>
    <div class="flex items-center gap-3 font-mono text-[0.6rem] uppercase tracking-[0.18em] text-muted">
      <span class="text-accent">{number}</span>
      <span aria-hidden="true">—</span>
      <span>{project.role}</span>
    </div>

    <h3 class="mt-3 font-display text-3xl font-normal leading-tight tracking-[-0.02em] transition-colors group-hover:text-accent sm:text-4xl">
      {project.title}
    </h3>

    <p class="mt-3 max-w-2xl text-sm leading-7 text-muted">
      {project.summary}
    </p>

    <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-1.5" aria-label="Stack">
      {
        project.stack.slice(0, 5).map((tech) => (
          <li class="font-mono text-[0.58rem] uppercase tracking-[0.12em] text-muted/90">
            {tech}
          </li>
        ))
      }
    </ul>

    {
      project.metrics.length > 0 && (
        <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3 border-t border-line pt-5">
          {project.metrics.slice(0, 3).map((metric) => (
            <div>
              <dt class="font-mono text-[0.56rem] uppercase tracking-[0.14em] text-muted">
                {metric.label}
              </dt>
              <dd class="mt-1 font-display text-xl text-ink">{metric.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <span class="mt-6 inline-flex items-center gap-2 font-mono text-[0.6rem] uppercase tracking-[0.16em] text-accent">
      Read case study
      <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
    </span>
  </div>

  {
    cover && (
      <div class="mt-6 overflow-hidden border border-line sm:mt-0 sm:self-start">
        <img
          src={cover.url}
          alt={cover.alt || `${project.title} interface preview`}
          loading="lazy"
          decoding="async"
          class="aspect-[16/10] w-full object-cover"
        />
      </div>
    )
  }
</a>
