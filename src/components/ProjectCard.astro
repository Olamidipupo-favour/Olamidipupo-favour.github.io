---
import type { Project } from "@/lib/types";
import { withBase } from "@/lib/utils";

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;

const palettes = [
  { bg: "#22C55E", ink: "#04170B" },
  { bg: "#FACC15", ink: "#1A1403" },
  { bg: "#38BDF8", ink: "#041018" },
  { bg: "#FB7185", ink: "#1B0509" },
  { bg: "#FB923C", ink: "#1B0A02" },
];
const palette = palettes[index % palettes.length];
const number = String(index + 1).padStart(2, "0");
---

<a
  href={withBase(`/projects/${project.slug}`)}
  class="project-card group relative flex min-h-[24rem] flex-col overflow-hidden border-2 border-ink transition-transform duration-200 hover:-translate-y-1 focus-visible:-translate-y-1 sm:min-h-[27rem]"
  style={`--card-bg:${palette.bg};--card-ink:${palette.ink};background:${palette.bg};color:${palette.ink};`}
>
  <div class="flex items-center justify-between gap-4 px-5 pt-4 font-mono text-[0.62rem] uppercase tracking-[0.14em] opacity-80">
    <span>Case {number}</span>
    <span>{project.role}</span>
  </div>

  <div class="px-5 pb-4 pt-5">
    <h3 class="font-display text-4xl font-black italic leading-none tracking-[-0.04em] sm:text-5xl">
      {project.title}
    </h3>
    <p class="mt-3 max-w-[32ch] text-sm font-medium leading-6 opacity-90">
      {project.summary}
    </p>
    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Stack">
      {
        project.stack.slice(0, 5).map((tech) => (
          <li class="border border-current px-1.5 py-0.5 font-mono text-[0.58rem] uppercase tracking-wider">
            {tech}
          </li>
        ))
      }
    </ul>
  </div>

  {
    project.metrics.length > 0 && (
      <dl class="relative z-10 mt-auto flex flex-wrap gap-x-5 gap-y-1 px-5 pb-4 font-mono text-[0.62rem] uppercase tracking-wider">
        {project.metrics.slice(0, 3).map((metric) => (
          <div>
            <dt class="opacity-70">{metric.label}</dt>
            <dd class="text-base font-bold tracking-tight">{metric.value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  <div class="relative mx-3 mb-3 mt-2 h-36 overflow-hidden border-2 border-current/70 bg-[#0A0D0C] text-[#E8F0EA] sm:absolute sm:inset-x-3 sm:bottom-3 sm:mx-0 sm:mb-0 sm:mt-0 sm:h-40 sm:translate-y-[calc(100%+1rem)] sm:opacity-0 sm:transition-all sm:duration-300 sm:ease-out sm:group-hover:translate-y-0 sm:group-hover:opacity-100 sm:group-focus-visible:translate-y-0 sm:group-focus-visible:opacity-100">
    {
      project.cover?.url ? (
        <img
          src={project.cover.url}
          alt={project.cover.alt || `${project.title} interface preview`}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      ) : (
        <div class="halftone-accent flex h-full flex-col">
          <div class="flex items-center gap-1.5 border-b border-[#2A352E] px-3 py-1.5">
            <span class="h-2 w-2 rounded-full bg-[#F87171]" aria-hidden="true"></span>
            <span class="h-2 w-2 rounded-full bg-[#FACC15]" aria-hidden="true"></span>
            <span class="h-2 w-2 rounded-full bg-[#22C55E]" aria-hidden="true"></span>
            <span class="ml-2 truncate font-mono text-[0.56rem] text-[#9AA8A0]">
              {project.slug}.dipo.dev
            </span>
          </div>
          <div class="flex flex-1 gap-3 p-3 font-mono">
            <div class="hidden w-16 shrink-0 space-y-1.5 border-r border-[#2A352E] pr-2 sm:block">
              <div class="h-1.5 w-full bg-[#22C55E]"></div>
              <div class="h-1.5 w-3/4 bg-[#2A352E]"></div>
              <div class="h-1.5 w-4/5 bg-[#2A352E]"></div>
              <div class="h-1.5 w-2/3 bg-[#2A352E]"></div>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-[0.6rem] text-[#22C55E]">$ curl -s {withBase(`/${project.slug}`)}</p>
              <p class="mt-1 truncate text-[0.6rem] text-[#E8F0EA]">200 OK · {project.stack[0] ?? "API"}</p>
              <div class="mt-2 space-y-1">
                <div class="h-1.5 w-11/12 bg-[#26332B]"></div>
                <div class="h-1.5 w-3/4 bg-[#26332B]"></div>
                <div class="h-1.5 w-5/6 bg-[#22C55E]/70"></div>
              </div>
              <div class="mt-2 grid grid-cols-3 gap-1">
                <div class="h-5 border border-[#2A352E] bg-[#132019]"></div>
                <div class="h-5 border border-[#2A352E] bg-[#132019]"></div>
                <div class="h-5 border border-[#2A352E] bg-[#132019]"></div>
              </div>
            </div>
          </div>
        </div>
      )
    }
    <span class="absolute bottom-2 right-2 border border-[#22C55E] bg-[#0A0D0C] px-2 py-1 font-mono text-[0.56rem] uppercase tracking-wider text-[#22C55E]">
      Open case study →
    </span>
  </div>
</a>
