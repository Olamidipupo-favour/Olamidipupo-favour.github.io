---
import { withBase } from "@/lib/utils";

interface Props {
  chapter: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const { chapter, title, description, href, linkLabel = "See all" } = Astro.props;
---

<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <p class="chapter-kicker">Chapter {chapter}</p>
    <h2 class="chapter-title mt-1">{title}</h2>
    {description && <p class="mt-3 max-w-prose text-sm leading-6 text-muted">{description}</p>}
  </div>
  {
    href && (
      <a
        href={withBase(href)}
        class="group inline-flex shrink-0 items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-accent hover:underline"
      >
        {linkLabel}
        <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">
          →
        </span>
      </a>
    )
  }
</div>
